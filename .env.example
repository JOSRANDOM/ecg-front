# URL del backend de la API ECG
# Desarrollo local:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Producción (backend en Railway):
NEXT_PUBLIC_API_URL=https://electrocardiographdevice-production.up.railway.app
# ⚠️ NEXT_PUBLIC_* se embebe en build time.
# En Vercel: configurar en Project Settings → Environment Variables.
# Con Docker local: docker build --build-arg NEXT_PUBLIC_API_URL=https://... .

# Puerto en el que corre el contenedor
APP_PORT=3000

# usuarios-service — auth real (server-side only, nunca NEXT_PUBLIC_*)
# Desarrollo local:
USUARIOS_SERVICE_URL=http://localhost:8001
# Debe ser idéntico al JWT_SECRET configurado en usuarios-service/.env
AUTH_JWT_SECRET=
