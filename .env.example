# URL del backend de la API ECG
# Desarrollo local:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Producción (Railway):
NEXT_PUBLIC_API_URL=https://electrocardiographdevice-production.up.railway.app

# URL de descarga del agente .exe (por defecto usa el endpoint del backend)
# Desarrollo local:
# NEXT_PUBLIC_AGENT_DOWNLOAD_URL=http://localhost:8000/agent/download
# Producción (Railway):
NEXT_PUBLIC_AGENT_DOWNLOAD_URL=https://electrocardiographdevice-production.up.railway.app/agent/download

# Puerto en el que corre el contenedor
APP_PORT=3000
